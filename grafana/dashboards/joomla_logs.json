
{
  "uid": "joomla-traffic",
  "title": "Tráfico web - Parcial Comunicaciones",
  "tags": ["comunicaciones", "nginx", "postgresql"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Peticiones HTTP por código",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "postgres-ds"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, '1m'), status::text AS metric, COUNT(*) AS value FROM nginx_requests WHERE $__timeFilter(ts) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Direcciones IP con más peticiones",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "postgres-ds"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT client_ip, COUNT(*) AS requests FROM nginx_requests WHERE $__timeFilter(ts) GROUP BY client_ip ORDER BY requests DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}